# Copie este arquivo para .env e ajuste conforme necessario:
#   cp .env.example .env
#
# IMPORTANTE: o arquivo .env NAO deve ser versionado (esta no .gitignore).
# Aqui NAO ha credenciais reais - apenas configuracao de operacao.

# Versao da aplicacao (usada para taggear as imagens e aparecer nas respostas/health)
APP_VERSION=v2

# Ambiente logico: producao | homologacao | desenvolvimento
AMBIENTE=producao

# Latencia simulada da calculadora, em segundos (config sem alterar codigo)
LATENCIA_SIMULADA=0.05
